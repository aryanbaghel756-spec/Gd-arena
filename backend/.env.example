# GD Arena - Backend Environment Configuration Example
# Copy this file to .env and configure your variables

# Active LLM Provider: ollama | groq | gemini (with automatic fallback to next provider)
LLM_PROVIDER=ollama

# Mock Mode: when true, returns deterministic canned responses without requiring any LLM API key
MOCK_MODE=true

# Ollama local endpoint
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Cloud LLM API Keys (optional if running locally with Ollama or in MOCK_MODE)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# CORS Allowed Origin for Frontend
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
